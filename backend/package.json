{
  "name": "passenger-manifest-api",
  "version": "1.0.0",
  "description": "Passenger Manifest API — trips, passengers, accounts/roles, and trip-numbering settings, backing the Excapism customer management frontend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "hash-password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.23.8"
  }
}
